<mxfile host="drawio" type="device">
  <diagram id="ratchet-architecture" name="Ratchet Architecture">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
                <mxCell id="human" value="&lt;b&gt;Human&lt;/b&gt;&lt;br&gt;root of authority: grants the first token" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;verticalAlign=middle;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="broker" value="&lt;b&gt;Ratchet broker&lt;/b&gt; · trusted, in-process, no model in the loop" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#b85450;dashed=1;fontFamily=Helvetica;fontSize=13;verticalAlign=top;align=right;spacingRight=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="1130" height="170" as="geometry"/></mxCell>
        <mxCell id="issuer" value="&lt;b&gt;Token issuer &amp;amp; exchange&lt;/b&gt;&lt;br&gt;issue() · exchange()&lt;br&gt;each hop gets a narrower token, re-bound to the next agent, never outliving its parent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;verticalAlign=middle;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="175" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="revoke" value="&lt;b&gt;Revocation store&lt;/b&gt;&lt;br&gt;revoking a token revokes everything delegated from it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;verticalAlign=middle;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="175" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="pep" value="&lt;b&gt;Policy enforcement point&lt;/b&gt;&lt;br&gt;authorize(): signature, revocation, holder, expiry, caveats&lt;br&gt;no model call · fails closed · ~10 µs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;verticalAlign=middle;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="175" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="audit" value="&lt;b&gt;Audit log&lt;/b&gt;&lt;br&gt;every decision, allowed or denied, hash-chained (JSONL)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;verticalAlign=middle;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="175" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="primary" value="&lt;b&gt;Primary agent&lt;/b&gt;&lt;br&gt;untrusted model&lt;br&gt;holds cap₁, bound to its own key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;verticalAlign=middle;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="sub" value="&lt;b&gt;Sub-agent&lt;/b&gt;&lt;br&gt;untrusted model&lt;br&gt;holds cap₂ ⊆ cap₁, bound to its own key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;verticalAlign=middle;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="400" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="adapters" value="&lt;b&gt;Framework adapters&lt;/b&gt; · every tool call passes through one" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f3f9f1;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="660" y="390" width="470" height="100" as="geometry"/></mxCell>
        <mxCell id="ad0" value="&lt;b&gt;LangGraph&lt;/b&gt;&lt;br&gt;tool-call middleware" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="670" y="422" width="105" height="58" as="geometry"/></mxCell>
        <mxCell id="ad1" value="&lt;b&gt;CrewAI&lt;/b&gt;&lt;br&gt;pre-tool-call hook" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="785" y="422" width="105" height="58" as="geometry"/></mxCell>
        <mxCell id="ad2" value="&lt;b&gt;AutoGen&lt;/b&gt;&lt;br&gt;intervention handler" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="422" width="105" height="58" as="geometry"/></mxCell>
        <mxCell id="ad3" value="&lt;b&gt;MCP&lt;/b&gt;&lt;br&gt;OAuth 2.1 resource server" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1015" y="422" width="105" height="58" as="geometry"/></mxCell>
        <mxCell id="tools" value="&lt;b&gt;Tools / MCP servers&lt;/b&gt;&lt;br&gt;external effects: APIs, files, payments" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;verticalAlign=middle;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="580" width="370" height="60" as="geometry"/></mxCell>
        <mxCell id="note" value="cap₂ ⊆ cap₁: caveats are HMAC-chained, so a hop can add restrictions but never remove one.&lt;br&gt;Every token is bound to its holder&#x27;s Ed25519 key: a stolen token is useless anywhere else.&lt;br&gt;The model never decides its own access: authorize() does, before every call." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="660" height="70" as="geometry"/></mxCell>
        <mxCell id="e1" value="1. issue(): root token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;fontColor=#222222;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="human" target="issuer"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175" y="50"/></Array></mxGeometry></mxCell>
        <mxCell id="e2" value="cap₁" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;fontColor=#222222;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="issuer" target="primary"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="2. exchange()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;fontColor=#222222;exitX=0.55;exitY=0;exitDx=0;exitDy=0;entryX=0.55;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="primary" target="issuer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="cap₂ ⊆ cap₁" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;fontColor=#222222;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="issuer" target="sub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="255" y="360"/><mxPoint x="450" y="360"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="delegates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="primary" target="sub"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e6" value="revoke" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;fontColor=#222222;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.791304;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="human" target="revoke"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e7" value="checks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="issuer" target="revoke"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="checks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;fontColor=#222222;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pep" target="revoke"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="appends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pep" target="audit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e10" value="tool call + token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sub" target="adapters"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e11" value="tool call + token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="primary" target="adapters"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175" y="530"/><mxPoint x="754" y="530"/></Array></mxGeometry></mxCell>
        <mxCell id="e12" value="3. authorize()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;fontColor=#222222;exitX=0.085106;exitY=0;exitDx=0;exitDy=0;entryX=0.347826;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="adapters" target="pep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e13" value="allow / deny" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;fontColor=#222222;exitX=0.782609;exitY=1;exitDx=0;exitDy=0;entryX=0.297872;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pep" target="adapters"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e14" value="4. runs only if allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#444444;fontColor=#222222;exitX=0.723404;exitY=1;exitDx=0;exitDy=0;entryX=0.648649;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="adapters" target="tools"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
